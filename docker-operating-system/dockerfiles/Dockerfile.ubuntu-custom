FROM ubuntu:22.04

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive

# Add labels for metadata
LABEL maintainer="yourusername"
LABEL description="Custom Ubuntu container with development tools"
LABEL version="1.0"

# Update package list, install development tools, and create user in a single layer
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    htop \
    nano \
    nodejs \
    npm \
    python3 \
    python3-pip \
    sudo \
    tree \
    unzip \
    vim \
    wget && \
    rm -rf /var/lib/apt/lists/* && \
    useradd -m -s /bin/bash developer && \
    usermod -aG sudo developer

# Set working directory
WORKDIR /workspace

# Copy custom configuration files (if any)
# COPY ./config/ /etc/
# COPY ./scripts/ /usr/local/bin/

# Set permissions
RUN chmod -R 755 /workspace

# Switch to non-root user (optional)
# USER developer

# Expose ports (if needed)
# EXPOSE 3000 8080

# Set default command
CMD ["/bin/bash"]
